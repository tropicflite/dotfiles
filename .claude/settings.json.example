{
  "statusLine": {
    "type": "command",
    "command": "python3 /home/matt/.claude/statusline-command.sh"
  },
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "skipDangerousModePermissionPrompt": true,
  "disableClaudeAiConnectors": true,
  "hooks": {
    "SessionStart": [
      {
        "matcher": "clear",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/dotfiles/.claude/hooks/session-start.sh"
          }
        ]
      }
    ]
  }
}
