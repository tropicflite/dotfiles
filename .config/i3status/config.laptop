# i3status configuration file.
# see "man i3status" for documentation.

general {
        colors = true
        interval = 5
}

order += "wireless wlan0"
order += "battery all"
order += "volume master"
order += "tztime local"

wireless wlan0 {
        format_up = "W: (%quality) %ip"
        format_down = "W: down"
}

battery all {
        format = "%status %percentage %remaining"
}

volume master {
    format = "♪: %volume"
    format_muted = "♪: muted (%volume)"
    device = "default"
}

tztime local {
        format = "%a %b %d %Y %I:%M:%P"
}
