#!/bin/bash
# fleet-update-digest — checks OS updates across the whole fleet (server,
# mini, laptop, desktop, phone, quest) once daily, instead of each machine
# notifying independently. Silent on a clean run; only sends (email+ntfy)
# when a machine doesn't upgrade as expected -- see the PROBLEM check below.
#
# Reads each machine's *today's* unattended-upgrades (or termux-upgrade) log
# entries over SSH — server itself is read locally, never SSH to self.
# Companion routine-mail suppression:
#   - server: Unattended-Upgrade::MailReport set to only-on-error
#   - mini/laptop/desktop: their built-in Mail already can't send (no local
#     MTA) so nothing to suppress there
#   - phone/quest: termux-upgrade only emails on failure, always logs
# Reboot-required nudges (reboot-check-notify / systemd drop-in) are left
# alone — those are low-frequency and actionable, not routine noise.

set -o pipefail
TODAY=$(date +%Y-%m-%d)
SSH_OPTS=(-o ConnectTimeout=10 -o BatchMode=yes)

APT_REMOTE_SCRIPT='
TODAY=$(date +%Y-%m-%d)
LOG=$(sudo grep "^$TODAY" /var/log/unattended-upgrades/unattended-upgrades.log 2>/dev/null)
ATTEMPTED=$(printf "%s\n" "$LOG" | grep -oE "Packages that will be upgraded: .*|No packages found.*|ERROR.*")
if printf "%s\n" "$ATTEMPTED" | grep -q "^Packages that will be upgraded"; then
    if printf "%s\n" "$LOG" | grep -q "All upgrades installed"; then
        printf "%s\n" "$ATTEMPTED" | sed "s/will be upgraded/were upgraded (confirmed installed)/"
    else
        printf "%s\n" "$ATTEMPTED"
        echo "WARNING: could not confirm these finished installing - check unattended-upgrades.log"
    fi
else
    printf "%s\n" "$ATTEMPTED"
fi
[ -f /var/run/reboot-required ] && echo "REBOOT_REQUIRED"
echo "PENDING:$(apt list --upgradable 2>/dev/null | tail -n +2 | wc -l)"
'

TERMUX_REMOTE_SCRIPT='
TODAY=$(date +%Y-%m-%d)
grep "^$TODAY" ~/.termux-upgrade.log 2>/dev/null | tail -5
'

fmt_section() {
    local name="$1" body="$2"
    if [ -z "$body" ]; then
        printf '== %s ==\nUNREACHABLE (ssh failed or timed out)\n\n' "$name"
        return
    fi
    local pending upgraded reboot rest
    pending=$(printf '%s\n' "$body" | grep -oE '^PENDING:[0-9]+' | cut -d: -f2)
    reboot=$(printf '%s\n' "$body" | grep -q '^REBOOT_REQUIRED' && echo yes || echo no)
    rest=$(printf '%s\n' "$body" | grep -vE '^PENDING:|^REBOOT_REQUIRED')
    [ -z "$rest" ] && rest="No run recorded today."
    printf '== %s ==\n%s\nPending (should be 0 or only intentionally-held packages): %s\nReboot required: %s\n\n' \
        "$name" "$rest" "${pending:-?}" "$reboot"
}

fmt_termux_section() {
    local name="$1" body="$2"
    if [ -z "$body" ]; then
        printf '== %s ==\nNo run recorded today (or unreachable).\n\n' "$name"
        return
    fi
    printf '== %s ==\n%s\n\n' "$name" "$body"
}

# --- server (local — never ssh to self) ---
server_body=$(bash -c "$APT_REMOTE_SCRIPT")
OUT="$(fmt_section "SERVER" "$server_body")"$'\n'

# --- mini / laptop (SysVinit, same apt log layout as server) ---
for host in mini laptop; do
    body=$(ssh "${SSH_OPTS[@]}" "$host" bash -s <<<"$APT_REMOTE_SCRIPT" 2>/dev/null)
    OUT+="$(fmt_section "${host^^}" "$body")"$'\n'
done

# --- desktop (WSL2 — may be off if Windows host is asleep/shut down) ---
desktop_body=$(ssh "${SSH_OPTS[@]}" desktop "wsl bash -s" <<<"$APT_REMOTE_SCRIPT" 2>/dev/null)
OUT+="$(fmt_section "DESKTOP" "$desktop_body")"$'\n'

# --- phone / quest (Termux, port 8022, separate log format) ---
for host in phone quest; do
    body=$(ssh "${SSH_OPTS[@]}" -p 8022 "$host" bash -s <<<"$TERMUX_REMOTE_SCRIPT" 2>/dev/null)
    OUT+="$(fmt_termux_section "${host^^}" "$body")"$'\n'
done

# 2026-07-27: Matt only wants to hear about this when a machine *doesn't*
# upgrade as expected -- assume success otherwise. "Not as expected" means:
# unreachable, an ERROR in the log, the "could not confirm installed"
# warning, or no unattended-upgrades/termux-upgrade run recorded at all today
# (the exact silent-failure mode already seen once on mini, see
# project_mini_shim_signed_unattended_upgrades_20260714 in memory). Reboot-
# required is deliberately NOT a trigger here -- that's already its own
# separate low-frequency nudge (ntfy-reboot-required), so this digest would
# just be duplicating it.
PROBLEM=false
printf '%s' "$OUT" | grep -qE 'UNREACHABLE \(ssh failed or timed out\)|ERROR|WARNING: could not confirm these finished installing|No run recorded today' \
    && PROBLEM=true

if ! $PROBLEM; then
    echo "$TODAY: all machines upgraded cleanly, nothing to report"
    exit 0
fi

SUBJECT="[Fleet] Update digest — $TODAY (needs attention)"
printf '%s' "$OUT" | grep -q '^Reboot required: yes' && SUBJECT="$SUBJECT, reboot required somewhere"

# Deliberately bypasses /usr/local/bin/send-mail here: send-mail calls bare
# `msmtp`, which resolves via $PATH to the alert-digest queue shim
# (msmtp-alert-queue) — this digest would get folded into the next 15-min
# alert-digest-flush under that pipeline's own combined subject, losing its
# own identity and the reboot-required flag. This is already a controlled,
# at-most-once-daily send with no duplicate-storm risk, so it goes straight
# to the real msmtp instead. It still calls send-alert directly for ntfy
# (same as send-mail does internally), so it counts toward the same 20/day
# cap tracking in msmtp.log and shows up in the same ntfy topic.
{
    printf "Subject: %s\r\n" "$SUBJECT"
    printf "\r\n"
    printf '%s' "$OUT"
} | /usr/bin/msmtp nichols_matt@pm.me

/usr/local/bin/send-alert "$SUBJECT" "See email for the full fleet update digest." high rotating_light
