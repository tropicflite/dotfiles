#!/bin/sh
# Install: sudo cp ~/dotfiles/scripts/server/bridge-watchdog /usr/local/bin/bridge-watchdog && sudo chmod +x /usr/local/bin/bridge-watchdog

python3 -c "
import smtplib, ssl, sys
ctx = ssl.create_default_context()
ctx.check_hostname = False
ctx.verify_mode = ssl.CERT_NONE
try:
    s = smtplib.SMTP('127.0.0.1', 1025, timeout=10)
    s.starttls(context=ctx)
    s.login('nichols_matt@pm.me', 'm40RhocwaFuWGSxhDXGLdw')
    s.quit()
    sys.exit(0)
except Exception:
    sys.exit(1)
" || {
    systemctl restart protonmail-bridge
    pass=$(cat /home/matt/.config/ntfy/password 2>/dev/null) && \
        curl -s -u "matt:$pass" \
            -H "Title: [server] Proton Bridge restarted" \
            -H "Priority: default" \
            -H "Tags: arrows_counterclockwise" \
            -d "SMTP auth failed; protonmail-bridge restarted at $(date)." \
            http://localhost:2586/server-alerts > /dev/null || true
}
