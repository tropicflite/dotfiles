#!/bin/bash
# Bundles server credentials and config not in git, GPG-encrypts, and emails
# as an attachment to nichols_matt@pm.me for manual save to Proton Drive.
# Run via root crontab: 0 4 1 * * /usr/local/bin/secrets-backup >> /var/log/secrets-backup.log 2>&1
#
# Scope: credentials and /etc config not covered by git (dotfiles or docker repo).
# Out of scope: GPG private key (backed up separately to Proton Drive / FileBrowser).

EMAIL="nichols_matt@pm.me"
GPG_RECIPIENT="matt@wayoffcourse.ca"
export GNUPGHOME="/home/matt/.gnupg"
NTFY_URL="http://localhost:2586/server-alerts"
NTFY_PASS_FILE="/home/matt/.config/ntfy/password"
PASS=$(cat "$NTFY_PASS_FILE" 2>/dev/null)
WORKDIR="$(mktemp -d /tmp/secrets-backup-XXXXXX)"
DATE="$(date +%Y%m%d)"
FILENAME="server-secrets-${DATE}.tar.gz.gpg"
ENCRYPTED="${WORKDIR}/${FILENAME}"

cleanup() { rm -rf "$WORKDIR"; }
trap cleanup EXIT

log() { echo "[$(date -Iseconds)] $*"; }

log "starting secrets backup"

# Export matt's crontab before bundling.
# Full path to runuser required: cron's default PATH for per-user crontabs
# (/usr/bin:/bin) does not include /usr/sbin, so a bare "runuser" silently
# fails to be found here even though it works fine in an interactive shell.
/usr/sbin/runuser -u matt -- crontab -l > "${WORKDIR}/matt-crontab.txt" 2>/dev/null

if [ ! -s "${WORKDIR}/matt-crontab.txt" ]; then
    log "WARNING: matt-crontab.txt is empty - crontab export failed or matt has no crontab"
    curl -s -u "matt:${PASS}" \
        -H "Title: [server] Secrets backup: crontab export empty" \
        -H "Priority: high" \
        -H "Tags: warning" \
        -d "matt's crontab export came back empty during this month's secrets backup - the rest of the bundle will still be sent, but a rebuild would restore an empty crontab. Check that matt actually has cron entries and that /usr/sbin/runuser is working." \
        "$NTFY_URL" > /dev/null
fi

# Bundle and encrypt in one pipe — plaintext never written to disk
tar -czf - --ignore-failed-read \
    /etc/wireguard/wg0.conf \
    /home/matt/.msmtprc \
    /etc/msmtprc \
    /home/matt/docker/immich/.env \
    /home/matt/docker/watchtower/.env \
    /home/matt/docker/homepage/.env \
    /home/matt/docker/nut-webgui/.env \
    /home/matt/docker/pihole/.env \
    /home/matt/docker/recyclarr/.env \
    /home/matt/docker/stirling-pdf/.env \
    /home/matt/docker/radicale/users \
    /home/matt/docker/scrutiny/config/scrutiny.yaml \
    /home/matt/docker/tsdproxy/config/authkey \
    /home/matt/.config/ntfy/password \
    /home/matt/.config/healthchecks/ping-url \
    /etc/nut/ \
    /etc/iptables/rules.v4 \
    /etc/iptables/rules.v6 \
    /etc/apt/apt.conf.d/99ntfy-reboot \
    /home/matt/.ssh/authorized_keys \
    /home/matt/.reminders \
    "${WORKDIR}/matt-crontab.txt" \
    2>/dev/null \
    | gpg --batch --no-tty -e -r "$GPG_RECIPIENT" -o "$ENCRYPTED"

if [ ! -s "$ENCRYPTED" ]; then
    log "ERROR: encrypted bundle is empty or missing — aborting"
    exit 1
fi

SIZE=$(du -sh "$ENCRYPTED" | cut -f1)
log "bundle created: ${FILENAME} (${SIZE})"

# Send as MIME email attachment
BOUNDARY="backup-$(date +%s)"
{
    printf "Subject: [server] Secrets backup %s\n" "$(date +%Y-%m-%d)"
    printf "To: %s\n" "$EMAIL"
    printf "From: matt@wayoffcourse.ca\n"
    printf "MIME-Version: 1.0\n"
    printf "Content-Type: multipart/mixed; boundary=\"%s\"\n\n" "$BOUNDARY"
    printf -- "--%s\n" "$BOUNDARY"
    printf "Content-Type: text/plain\n\n"
    printf "Server secrets backup — %s\n\n" "$(date)"
    printf "Contents: WireGuard keys, msmtp credentials, docker .env files (immich,\n"
    printf "watchtower, homepage, nut-webgui, pihole, recyclarr, stirling-pdf), radicale\n"
    printf "htpasswd, scrutiny.yaml, tsdproxy authkey, ntfy password, healthchecks URL,\n"
    printf "NUT config, iptables rules, apt hooks, authorized_keys, .reminders, matt's crontab.\n\n"
    printf "GPG key is backed up separately (Proton Drive / FileBrowser) — not in this bundle.\n\n"
    printf "Save this attachment to Proton Drive.\n"
    printf -- "\n--%s\n" "$BOUNDARY"
    printf "Content-Type: application/octet-stream\n"
    printf "Content-Disposition: attachment; filename=\"%s\"\n" "$FILENAME"
    printf "Content-Transfer-Encoding: base64\n\n"
    base64 -w 76 "$ENCRYPTED"
    printf -- "\n--%s--\n" "$BOUNDARY"
} | msmtp -C /etc/msmtprc "$EMAIL"
MSMTP_EXIT=$?

if [ $MSMTP_EXIT -ne 0 ]; then
    log "ERROR: msmtp failed to send backup email (exit ${MSMTP_EXIT}) — check /var/log/msmtp.log"
    curl -s -u "matt:${PASS}" \
        -H "Title: [server] Secrets backup FAILED" \
        -H "Priority: high" \
        -H "Tags: warning" \
        -d "Monthly secrets backup encrypted (${SIZE}) but the email send failed (msmtp exit ${MSMTP_EXIT}). Check /var/log/msmtp.log on server." \
        "$NTFY_URL" > /dev/null
    exit 1
fi

log "email sent to ${EMAIL}"

# ntfy notification
curl -s -u "matt:${PASS}" \
    -H "Title: [server] Secrets backup sent" \
    -H "Priority: default" \
    -H "Tags: floppy_disk" \
    -d "Monthly secrets backup emailed (${SIZE}). Save attachment to Proton Drive." \
    "$NTFY_URL" > /dev/null

log "done"
