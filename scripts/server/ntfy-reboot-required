#!/bin/bash
# Sends ntfy when /run/reboot-required is set by apt/dpkg.
# Called via DPkg::Post-Invoke (/etc/apt/apt.conf.d/99ntfy-reboot).
# Deduplicates with /run/ntfy-reboot-notified (tmpfs — auto-clears on reboot).
[ -f /run/reboot-required ] || exit 0
[ -f /run/ntfy-reboot-notified ] && exit 0

PKGS=$(sort -u /run/reboot-required.pkgs 2>/dev/null | tr '\n' ' ')
BODY="Kernel or system packages updated — reboot when convenient.${PKGS:+
Packages: ${PKGS}}"

/usr/local/bin/send-alert "[server] Reboot required" "$BODY" high rotating_light

touch /run/ntfy-reboot-notified
