#!/bin/sh
# Install: sudo cp ~/dotfiles/scripts/server/upssched-cmd /usr/bin/upssched-cmd && sudo chmod +x /usr/bin/upssched-cmd
# Requires: /etc/nut/ntfy-password (root:nut 640) — copy from ~/.config/ntfy/password

send_ntfy() {
    pass=$(cat /etc/nut/ntfy-password 2>/dev/null) || return 0
    curl -s -u "matt:$pass" \
        -H "Title: $1" -H "Priority: $2" -H "Tags: $3" \
        -d "$4" \
        http://localhost:2586/server-alerts > /dev/null || true
}

case $1 in
    onbatt-notify)
        logger -t upssched-cmd "UPS on battery - sending notification email"
        printf "Subject: UPS on battery\nTo: nichols_matt@pm.me\nFrom: matt@wayoffcourse.ca\n\nUPS apc1000 switched to battery power at $(date).\n" | msmtp nichols_matt@pm.me
        send_ntfy "[server] UPS on battery" "high" "warning,battery" "UPS apc1000 switched to battery power at $(date)."
        ;;
    onbatt-warn)
        logger -t upssched-cmd "UPS on battery for 30s"
        wall "UPS WARNING: Server running on battery - power may be out"
        ;;
    onbatt-shutdown)
        status=$(upsc apc1000 ups.status 2>/dev/null)
        if echo "$status" | grep -q "OB"; then
            logger -t upssched-cmd "UPS on battery for 15 minutes (status=$status) - initiating FSD"
            sudo /usr/sbin/upsmon -c fsd
        else
            logger -t upssched-cmd "15-min timer fired but UPS is back online (status=$status) - skipping FSD"
        fi
        ;;
    lowbatt-shutdown)
        logger -t upssched-cmd "UPS battery critical - initiating FSD"
        send_ntfy "[server] UPS battery critical — shutting down" "max" "rotating_light" "UPS battery critical on $(hostname). Initiating safe shutdown now."
        sudo /usr/sbin/upsmon -c fsd
        ;;
    *)
        logger -t upssched-cmd "Unrecognized command: $1"
        ;;
esac
