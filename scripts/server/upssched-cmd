#!/bin/sh
# Install: sudo cp ~/dotfiles/scripts/server/upssched-cmd /usr/local/bin/upssched-cmd && sudo chmod +x /usr/local/bin/upssched-cmd
# Lives in /usr/local/bin, NOT /usr/bin: /usr/bin/upssched-cmd is a non-conffile
# owned by nut-client, so every nut upgrade overwrites it with the stock example
# (happened 2026-11-21 via unattended-upgrades, silently killing all power alerts
# and the 15-min FSD). upssched.conf CMDSCRIPT points here.
# Requires: /etc/nut/ntfy-password (root:nut 640) — copy from ~/.config/ntfy/password
# ntfy sends go through /usr/local/bin/send-alert (a real file, not the
# send-mail symlink — /home/matt is 700 and the nut user can't traverse a
# symlink back into ~/dotfiles). send-alert auto-detects /etc/nut/ntfy-password
# when it can't read matt's home dir, so no override is needed here.

send_ntfy() {
    /usr/local/bin/send-alert "$1" "$4" "$2" "$3"
}

case $1 in
    onbatt-notify)
        # No alert here: brief utility blips (APC reports them as exactly 5s)
        # happen ~3x/month. Just record the start; onbatt-warn alerts at 30s.
        logger -t upssched-cmd "UPS on battery - alert deferred until 30s (debounce)"
        date +%s > /run/nut/onbatt-time
        rm -f /run/nut/onbatt-alerted
        ;;
    online-notify)
        if [ -f /run/nut/onbatt-time ]; then
            start=$(cat /run/nut/onbatt-time)
            elapsed=$(( $(date +%s) - start ))
            duration="$(( elapsed / 60 ))m $(( elapsed % 60 ))s"
            rm -f /run/nut/onbatt-time
        else
            duration="unknown"
        fi
        if [ -f /run/nut/onbatt-alerted ]; then
            rm -f /run/nut/onbatt-alerted
            logger -t upssched-cmd "UPS power restored after ${duration} on battery"
            printf "Subject: UPS power restored\nTo: alerts@wayoffcourse.ca\nFrom: matt@wayoffcourse.ca\n\nUPS apc1000 restored to mains power at $(date).\nTime on battery: ${duration}.\n" | msmtp alerts@wayoffcourse.ca
            send_ntfy "[server] UPS power restored" "default" "white_check_mark" "UPS apc1000 restored to mains power at $(date). Time on battery: ${duration}."
        else
            logger -t upssched-cmd "UPS power restored after ${duration} on battery (blip under 30s - no alert sent)"
        fi
        ;;
    onbatt-warn)
        # 30s debounce timer (cancelled by ONLINE). Re-check status anyway as
        # defense-in-depth: if an ONLINE event is ever missed (it was on
        # 2026-07-02, from a missing NOTIFYFLAG EXEC), a 5s blip must not
        # become a false alert here.
        # DISCHRG too: this UPS can report "CAL DISCHRG" instead of OB while on battery.
        status=$(upsc apc1000 ups.status 2>/dev/null)
        if echo "$status" | grep -qE "OB|DISCHRG"; then
            logger -t upssched-cmd "UPS on battery for 30s (status=$status) - sending notification"
            touch /run/nut/onbatt-alerted
            wall "UPS WARNING: Server running on battery - power may be out"
            printf "Subject: UPS on battery\nTo: alerts@wayoffcourse.ca\nFrom: matt@wayoffcourse.ca\n\nUPS apc1000 has been on battery power for 30+ seconds as of $(date).\nAutomatic safe shutdown after 15 minutes on battery.\n" | msmtp alerts@wayoffcourse.ca
            send_ntfy "[server] UPS on battery" "high" "warning,battery" "UPS apc1000 on battery for 30+ seconds as of $(date). Safe shutdown after 15 min."
        else
            logger -t upssched-cmd "30s timer fired but UPS is back online (status=$status) - no alert"
        fi
        ;;
    onbatt-shutdown)
        status=$(upsc apc1000 ups.status 2>/dev/null)
        # DISCHRG too: this UPS can report "CAL DISCHRG" instead of OB while on battery.
        if echo "$status" | grep -qE "OB|DISCHRG"; then
            logger -t upssched-cmd "UPS on battery for 15 minutes (status=$status) - initiating FSD"
            send_ntfy "[server] UPS shutting down — sustained outage" "max" "rotating_light" "UPS apc1000 on battery for 15+ minutes (status=$status) on $(hostname). Initiating safe shutdown now."
            sudo /usr/sbin/upsmon -c fsd
        else
            logger -t upssched-cmd "15-min timer fired but UPS is back online (status=$status) - skipping FSD"
        fi
        ;;
    lowbatt-shutdown)
        logger -t upssched-cmd "UPS battery critical - initiating FSD"
        send_ntfy "[server] UPS battery critical — shutting down" "max" "rotating_light" "UPS battery critical on $(hostname). Initiating safe shutdown now."
        sudo /usr/sbin/upsmon -c fsd
        ;;
    replbatt-notify)
        # upsmon re-raises REPLBATT every RBWARNTIME (12h); alert at most once/24h.
        # Marker in /run/nut so a reboot re-arms it.
        marker=/run/nut/replbatt-last
        now=$(date +%s); last=$(cat "$marker" 2>/dev/null || echo 0)
        logger -t upssched-cmd "UPS reports battery needs replacement (RB)"
        if [ $(( now - last )) -ge 86400 ]; then
            echo "$now" > "$marker"
            printf "Subject: UPS battery needs replacement\nTo: alerts@wayoffcourse.ca\nFrom: matt@wayoffcourse.ca\n\nUPS apc1000 is reporting Replace Battery (RB) as of $(date).\nBattery mfr date: $(upsc apc1000 battery.mfr.date 2>/dev/null)\nLast self-test: $(upsc apc1000 ups.test.result 2>/dev/null)\nRuntime now: $(upsc apc1000 battery.runtime 2>/dev/null)s at $(upsc apc1000 ups.load 2>/dev/null)% load\n\nOrder a replacement battery cartridge (APC battery selector for Back-UPS RS 1000MS).\n" | msmtp alerts@wayoffcourse.ca
            send_ntfy "[server] UPS battery needs replacement" "high" "warning,battery" "UPS apc1000 reports Replace Battery (RB). Order a replacement cartridge."
        fi
        ;;
    *)
        logger -t upssched-cmd "Unrecognized command: $1"
        ;;
esac
