[Unit]
Description=ntfy Docker Compose
Requires=docker.service tailscale-ready.service
After=docker.service tailscale-ready.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/home/matt/docker/ntfy
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=60

[Install]
WantedBy=multi-user.target
