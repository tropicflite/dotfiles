[Unit]
Description=Radicale CardDAV Docker Compose
After=docker.service tailscale-ready.service mnt-data.mount
Requires=docker.service tailscale-ready.service mnt-data.mount

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/home/matt/docker/radicale
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=60

[Install]
WantedBy=multi-user.target
