[Unit]
Description=Homepage Docker Compose
Requires=docker.service mnt-data.mount mnt-immich\x2dbackup.mount immich-compose.service
After=docker.service tailscaled.service mnt-data.mount mnt-immich\x2dbackup.mount immich-compose.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/home/matt/docker/homepage
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=60

[Install]
WantedBy=multi-user.target
