#!/bin/bash
LOGFILE=/var/log/ups-charge.log
ONBATT_MARKER=/run/nut/onbatt-time
data=$(upsc apc1000 2>/dev/null)
charge=$(echo "$data" | awk -F': ' '/^battery\.charge:/{print $2}')
status=$(echo "$data" | awk -F': ' '/^ups\.status:/{print $2}' | tr ' ' '_')
runtime=$(echo "$data" | awk -F': ' '/^battery\.runtime:/{print $2}')
voltage=$(echo "$data" | awk -F': ' '/^input\.voltage:/{print $2}')
load=$(echo "$data" | awk -F': ' '/^ups\.load:/{print $2}')
# Brother HL-2270DW page count + panel state (2026-11-22): correlate UPS
# transfers with laser-fuser warmups. Network printer, so jobs from other
# devices never touch server CUPS — the page counter is the only record.
# Not on battery-backed power, so "-" during an outage is expected.
PRINTER=192.168.50.150
pages=$(curl -s -m3 "http://$PRINTER/printer/maininfo.html" | grep -oE 'Page&#32;Count</DD></TD><TD>[0-9]+' | grep -oE '[0-9]+$')
pstate=$(curl -s -m3 "http://$PRINTER/printer/main.html" | grep -oE '<tt>(&nbsp;)*[A-Z][A-Za-z ]*[A-Za-z]' | head -1 | sed 's/<tt>//; s/&nbsp;//g; s/ /_/g')
echo "$(date -Iseconds) charge=${charge} status=${status} runtime=${runtime}s voltage=${voltage}V load=${load}% pages=${pages:--} printer=${pstate:--}" >> "$LOGFILE"

# Backstop: upssched's pipe-based IPC has been observed (2026-07-02) to
# silently drop the ONLINE event under rapid ONBATT->ONLINE transitions, so
# upssched-cmd's online-notify handler never runs and no "power restored"
# alert goes out. If the onbatt marker is still present but we're no longer
# on battery, send the alert ourselves and clean up the marker.
# "On battery" = OB *or* DISCHRG: with onlinedischarge_calibration=yes this
# Back-UPS reports "CAL DISCHRG" (no OB) during real transfers, which made the
# backstop fire 1s into the 2026-11-22 dip and eat the marker. Also require the
# marker to be >=60s old so we never race upssched's own online-notify.
if [[ -f "$ONBATT_MARKER" && "$status" != *OB* && "$status" != *DISCHRG* ]] \
   && (( $(date +%s) - $(cat "$ONBATT_MARKER") >= 60 )); then
    start=$(cat "$ONBATT_MARKER")
    elapsed=$(( $(date +%s) - start ))
    duration="$(( elapsed / 60 ))m $(( elapsed % 60 ))s"
    rm -f "$ONBATT_MARKER"
    if [[ -f /run/nut/onbatt-alerted ]]; then
        rm -f /run/nut/onbatt-alerted
        logger -t ups-charge-log "backstop: online-notify never fired, sending power-restored alert after ${duration} on battery"
        ntfy_body="UPS apc1000 restored to mains power. Time on battery: ${duration}. (Sent by ups-charge-log backstop -- primary handler did not fire.)"
        printf "Subject: UPS power restored (backstop alert)\nTo: alerts@wayoffcourse.ca\nFrom: matt@wayoffcourse.ca\n\nUPS apc1000 restored to mains power (detected via ups-charge-log backstop -- the primary upssched online-notify handler did not fire).\nTime on battery: ${duration}.\n" | \
            NTFY_TAGS=white_check_mark NTFY_BODY="$ntfy_body" \
            /usr/local/bin/send-mail
    else
        # No "on battery" alert went out (blip under the 30s debounce), so no restored alert either.
        logger -t ups-charge-log "backstop: online-notify never fired; blip under 30s, cleaned up marker (no alert)"
    fi
fi
