#!/bin/bash
# Quick post-reboot health check. Usage: server-health

GREEN='\033[0;32m'
RED='\033[0;31m'
YELLOW='\033[0;33m'
NC='\033[0m'
BOLD='\033[1m'

OK="${GREEN}✓${NC}"
FAIL="${RED}✗${NC}"
WARN="${YELLOW}!${NC}"

issues=0
failures=""

check() {
    local label="$1" status="$2" detail="$3"
    case "$status" in
        ok)   printf "  ${OK} %-12s " "$label" ;;
        fail) printf "  ${FAIL} %-12s " "$label"; ((issues++))
              failures+="${label}${detail:+ (${detail})}"$'\n' ;;
        warn) printf "  ${WARN} %-12s " "$label" ;;
    esac
    [ -n "$detail" ] && printf "%s" "$detail"
    printf "\n"
}

clear
echo
printf "${BOLD}=== Server health — $(date '+%m-%d %H:%M') ===${NC}\n"
echo

# Systemd
failed=$(systemctl --failed --no-legend --no-pager 2>/dev/null | awk 'NF{print $1}' | paste -sd ' ')
if [ -z "$failed" ]; then
    check "Systemd" ok "no failed units"
else
    check "Systemd" fail "$failed"
fi

# Docker — summary line; expand only failures/warnings
ok_count=0; warn_count=0; fail_count=0; warn_names=""; fail_names=""
while IFS=$'\t' read -r name state status_str; do
    health=$(echo "$status_str" | grep -oP '(?<=\()[^)]+(?=\))' || true)
    if [ "$state" != "running" ]; then
        ((fail_count++)); fail_names+="${name}(${state}) "
    elif [ "$health" = "unhealthy" ]; then
        ((fail_count++)); fail_names+="${name}(unhealthy) "
    elif echo "$health" | grep -q "starting"; then
        ((warn_count++)); warn_names+="${name} "
    else
        ((ok_count++))
    fi
done < <(docker ps -a --format $'{{.Names}}\t{{.State}}\t{{.Status}}' | sort)
total=$(( ok_count + warn_count + fail_count ))
if [ "$fail_count" -gt 0 ]; then
    check "Docker" fail "${ok_count}/${total} ok — ${fail_names% }"
elif [ "$warn_count" -gt 0 ]; then
    check "Docker" warn "${ok_count}/${total} ok — starting: ${warn_names% }"
else
    check "Docker" ok "all ${ok_count} running"
fi

# Internet
for host in 8.8.8.8 1.1.1.1; do
    result=$(ping -c 1 -W 3 "$host" 2>/dev/null)
    if [ $? -eq 0 ]; then
        ms=$(echo "$result" | awk -F'/' 'END{printf "%.0f", $5}')
        check "$host" ok "${ms}ms"
    else
        check "$host" fail "no response"
    fi
done

# Tailscale
if ! tailscale status &>/dev/null; then
    check "Tailscale" fail "not running"
else
    ts_ip=$(tailscale ip -4 2>/dev/null)
    check "Tailscale" ok "up — ${ts_ip}"
fi

# WireGuard
if ! ip link show wg0 &>/dev/null; then
    check "WireGuard" fail "interface not up"
else
    handshake=$(sudo wg show wg0 latest-handshakes 2>/dev/null | awk '{print $2}')
    if [ -z "$handshake" ] || [ "$handshake" = "0" ]; then
        check "WireGuard" fail "no handshake yet"
    else
        age=$(( $(date +%s) - handshake ))
        if [ "$age" -lt 300 ]; then
            check "WireGuard" ok "handshake ${age}s ago"
        elif [ "$age" -lt 600 ]; then
            check "WireGuard" warn "last handshake ${age}s ago"
        else
            check "WireGuard" fail "last handshake ${age}s ago"
        fi
    fi
fi

# Disk
for mount in / /mnt/data; do
    if ! mountpoint -q "$mount" 2>/dev/null && [ "$mount" != "/" ]; then
        check "$mount" fail "not mounted"
        continue
    fi
    pct=$(df --output=pcent "$mount" 2>/dev/null | tail -1 | tr -d ' %')
    avail=$(df -h --output=avail "$mount" 2>/dev/null | tail -1 | tr -d ' ')
    if [ -z "$pct" ]; then
        check "$mount" fail "unavailable"
    elif [ "$pct" -ge 90 ]; then
        check "$mount" fail "${pct}% (${avail} free)"
    elif [ "$pct" -ge 80 ]; then
        check "$mount" warn "${pct}% (${avail} free)"
    else
        check "$mount" ok "${pct}% (${avail} free)"
    fi
done

# UPS
if ! upsc apc1000 &>/dev/null 2>&1; then
    check "UPS" fail "upsc unavailable"
else
    ups_status=$(upsc apc1000 ups.status 2>/dev/null)
    batt_pct=$(upsc apc1000 battery.charge 2>/dev/null)
    detail="${ups_status}${batt_pct:+, ${batt_pct}%}"
    if [ "$ups_status" != "OL" ] && [ "$ups_status" != "OL CHRG" ]; then
        check "UPS" fail "$detail"
    elif [ -n "$batt_pct" ] && [ "$batt_pct" -lt 50 ]; then
        check "UPS" warn "$detail"
    else
        check "UPS" ok "$detail"
    fi
fi

# Summary
echo
if [ "$issues" -eq 0 ]; then
    printf "${GREEN}${BOLD}All good.${NC}\n"
else
    printf "${RED}${BOLD}${issues} issue(s) found — see above.${NC}\n"
    echo
    if [[ -z "${NTFY_PASSWORD:-}" ]]; then
        NTFY_PASSWORD=$(cat ~/.config/ntfy/password 2>/dev/null) || true
    fi
    if [[ -z "${NTFY_PASSWORD:-}" ]]; then
        read -rsp "ntfy password for matt: " NTFY_PASSWORD
        echo
    fi
    body=$(printf "%d issue(s) found on %s:\n%s" "$issues" "$(hostname)" "$failures")
    curl -s \
        -u "matt:$NTFY_PASSWORD" \
        -H "Title: [server] Health check failed" \
        -H "Priority: high" \
        -H "Tags: rotating_light" \
        -d "$body" \
        http://localhost:2586/server-alerts > /dev/null \
        && printf "  ntfy alert sent.\n"
fi
echo
