[Unit]
Description=WireGuard VPN - wg0
After=network-online.target tailscaled.service pihole-compose.service
Wants=network-online.target tailscaled.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStartPre=/usr/local/bin/wg0-prestart.sh
# Routes + iptables all live in wg0-up-extra.sh, invoked as PostUp in wg0.conf —
# the single code path shared by boot, systemctl, and wg-watchdog wg-quick
# bounces. (ExecStart previously added the main-table routes itself; a bare
# wg-quick bounce then silently lost them — 2026-07-02 incident.)
ExecStart=/usr/bin/wg-quick up /etc/wireguard/wg0.conf
ExecStopPost=/usr/local/bin/wg0-down-extra.sh
ExecStop=/bin/bash -c '\
  EP=$(grep -m1 "^Endpoint" /etc/wireguard/wg0.conf | cut -d= -f2 | cut -d: -f1 | tr -d " "); \
  ip route del 0.0.0.0/0 dev wg0 metric 100 2>/dev/null || true && \
  ip route del "${EP}/32" 2>/dev/null || true && \
  wg-quick down /etc/wireguard/wg0.conf'

[Install]
WantedBy=multi-user.target
