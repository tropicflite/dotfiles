#!/data/data/com.termux/files/usr/bin/bash
export PATH=/data/data/com.termux/files/usr/bin:$PATH

OUTPUT=$(pkg update -y 2>&1 && pkg upgrade -y 2>&1)

UPGRADED=$(echo "$OUTPUT" | grep -oE "[0-9]+ upgraded" | grep -oE "^[0-9]+" | head -1)
UPGRADED=${UPGRADED:-0}

UPGRADED_LIST=$(echo "$OUTPUT" | sed -nE 's/^Unpacking ([^ ]+) \(([^)]+)\) over \(([^)]+)\).*/\1 (\3 → \2)/p')

FAILED_PKGS=$(echo "$OUTPUT" | sed -nE 's/^dpkg: error processing package ([^ ]+).*/\1/p')
FETCH_ERRORS=$(echo "$OUTPUT" | grep '^E: ' | sed 's/^E: //')

MACHINE=$(cat "$PREFIX/etc/machine-name" 2>/dev/null || echo phone)

# Always log, even on a quiet day — fleet-update-digest (runs on the server)
# reads this to build the daily fleet-wide summary, so a routine run no
# longer needs to email on its own.
FAILED_FLAG=no
[ -n "$FAILED_PKGS$FETCH_ERRORS" ] && FAILED_FLAG=yes
echo "$(date +%Y-%m-%d) upgraded=$UPGRADED failed=$FAILED_FLAG" >> ~/.termux-upgrade.log

# Only email directly on failure — routine success is picked up by the
# next fleet-update-digest run instead of paging immediately.
[ "$FAILED_FLAG" = no ] && exit 0

BODY="Upgraded: $UPGRADED package(s)"
[ -n "$UPGRADED_LIST" ] && BODY="$BODY
$UPGRADED_LIST"

BODY="$BODY

Failed:"
[ -n "$FAILED_PKGS" ] && BODY="$BODY
$FAILED_PKGS"
[ -n "$FETCH_ERRORS" ] && BODY="$BODY
$FETCH_ERRORS"

{
    printf "To: nichols_matt@pm.me\r\n"
    printf "From: matt@wayoffcourse.ca\r\n"
    printf "Subject: [%s] Termux: upgrade FAILED\r\n" "$MACHINE"
    printf "\r\n"
    printf "%s\n" "$BODY"
} | ssh -p 28901 -i /data/data/com.termux/files/home/.ssh/id_ed25519_sendmail -o BatchMode=yes matt@100.65.250.53
