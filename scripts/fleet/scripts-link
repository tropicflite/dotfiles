#!/usr/bin/env zsh
# Symlink fleet and machine-specific scripts into ~/bin
setopt nullglob
SCRIPTS_DIR="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
BIN_DIR="$HOME/bin"
MACHINE=$("$SCRIPTS_DIR/fleet/machine-name")
mkdir -p "$BIN_DIR"

# Non-phone Termux devices (quest) share phone's scripts (termux-upgrade,
# batt, etc.) as a baseline, since they're both Termux and mostly identical.
# A device dir of its own (e.g. scripts/quest/) is layered on top and linked
# after, so same-named scripts there override the phone baseline — this is
# how quest's start-crond.sh (adds a boot-time upgrade stamp gate phone
# doesn't need) can diverge from phone's plain version while both still
# share termux-upgrade/batt/etc. from scripts/phone/.
LINK_DIRS=("$SCRIPTS_DIR/fleet")
if [ -n "$PREFIX" ] && [ "$MACHINE" != "phone" ]; then
  LINK_DIRS+=("$SCRIPTS_DIR/phone")
fi
[ -d "$SCRIPTS_DIR/$MACHINE" ] && LINK_DIRS+=("$SCRIPTS_DIR/$MACHINE")

# Prune stale links left behind by renamed or deleted scripts.
# Only touch broken links that point back into this scripts dir, so links to
# anything else the user keeps in ~/bin are left alone.
for link in "$BIN_DIR"/*(N); do
  [ -L "$link" ] || continue
  [ -e "$link" ] && continue            # target still exists → keep
  case "$(readlink "$link")" in
    "$SCRIPTS_DIR"/*) rm -f "$link"; echo "pruned stale: $(basename "$link")" ;;
  esac
done

for dir in "${LINK_DIRS[@]}"; do
  [ -d "$dir" ] || continue
  for script in "$dir"/*; do
    [ -f "$script" ] || continue
    # Only mark real scripts executable. Config/data files (compose, .service,
    # .yaml, .conf) are linked for convenience but must stay non-executable, or
    # the chmod shows up as a spurious mode change every time this runs.
    IFS= read -r _shebang < "$script"
    [[ $_shebang == '#!'* && ! -x "$script" ]] && chmod +x "$script"
    ln -sf "$script" "$BIN_DIR/$(basename "$script")"
    echo "linked: $(basename "$script")"
  done
done
