#!/bin/bash
# purge-secret — scrub a leaked secret from all of ~/dotfiles' git history.
# Codifies the pattern used three times now (Pi-hole password, NUT password,
# ntfy.sh public topic ID — see feedback_dotfiles_secret_handling memory):
# back up .git, clear the git-filter-repo "already_ran" continuation marker
# (bites on a second run in the same checkout otherwise), replace the value
# everywhere in history, re-add the origin remote (filter-repo strips it),
# verify the value is actually gone.
#
# Does NOT force-push by default — that's a shared-history rewrite and stays
# a deliberate, visible last step. Pass --push to also force-push.
#
# Usage:
#   purge-secret <old-value> [<replacement>]          # local rewrite only
#   purge-secret <old-value> [<replacement>] --push    # rewrite + force-push
set -euo pipefail

DOTFILES="$HOME/dotfiles"
REMOTE_NAME="origin"

PUSH=false
ARGS=()
for a in "$@"; do
    if [[ "$a" == "--push" ]]; then
        PUSH=true
    else
        ARGS+=("$a")
    fi
done

OLD="${ARGS[0]:-}"
NEW="${ARGS[1]:-REDACTED}"

if [[ -z "$OLD" ]]; then
    echo "usage: purge-secret <old-value> [<replacement>] [--push]" >&2
    exit 1
fi

if ! command -v git-filter-repo &>/dev/null; then
    echo "purge-secret: git-filter-repo not found on PATH." >&2
    exit 1
fi

cd "$DOTFILES"

if [[ -n "$(git status --porcelain)" ]]; then
    echo "purge-secret: working tree not clean — commit or stash first." >&2
    exit 1
fi

REMOTE_URL=$(git remote get-url "$REMOTE_NAME" 2>/dev/null || true)
if [[ -z "$REMOTE_URL" ]]; then
    echo "purge-secret: no '$REMOTE_NAME' remote configured — aborting." >&2
    exit 1
fi

BACKUP_DIR="$HOME/.local/share/dotfiles-git-backups"
mkdir -p "$BACKUP_DIR"
BACKUP="$BACKUP_DIR/dotfiles-git-$(date +%Y%m%d%H%M%S).tar.gz"
tar czf "$BACKUP" -C "$DOTFILES" .git
echo "backed up .git -> $BACKUP"

MARKER="$DOTFILES/.git/filter-repo/already_ran"
if [[ -f "$MARKER" ]]; then
    rm -f "$MARKER"
    echo "removed stale filter-repo continuation marker"
fi

RULES=$(mktemp)
trap 'rm -f "$RULES"' EXIT
printf '%s==>%s\n' "$OLD" "$NEW" > "$RULES"

git-filter-repo --replace-text "$RULES" --force

git remote add "$REMOTE_NAME" "$REMOTE_URL"
echo "re-added remote: $REMOTE_NAME -> $REMOTE_URL"

if git log --all -S"$OLD" --oneline | grep -q .; then
    echo "WARNING: value still found in history after filter-repo — investigate before pushing." >&2
    exit 1
fi
echo "verified: old value no longer present in any commit."

if $PUSH; then
    echo "force-pushing to $REMOTE_NAME master..."
    git push --force "$REMOTE_NAME" master
    echo "done. Other fleet machines need: fdotl"
else
    echo
    echo "Local history rewritten, not pushed. To finish:"
    echo "  git push --force $REMOTE_NAME master"
    echo "then run fdotl across the fleet."
fi
