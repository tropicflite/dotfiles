#!/bin/sh
# dotp-secret-scan — greps dotp's staged changes for credential-shaped
# additions before they're committed. A speed bump for accidental slip-ups,
# not a real secret scanner (false positives/negatives both possible) —
# see feedback_dotfiles_secret_handling memory for the incident (a real
# leaked secret needed git-filter-repo cleanup) this exists to catch
# earlier next time. Only checks ADDED lines, so removing a secret never
# trips this. `dotp --force` bypasses it for confirmed false positives.
# Optional $1: repo path to scan (defaults to ~/dotfiles). Exists so this
# is testable against a scratch copy without staging anything for real.

cd "${1:-$HOME/dotfiles}" || exit 1

git diff --cached -U0 -- . ':!*.lock' ':!*lazy-lock.json' | awk '
  /^\+\+\+ b\// { file = substr($0, 7); next }
  /^\+/ && !/^\+\+\+/ {
    content = substr($0, 2)
    lc = tolower(content)
    generic = (lc ~ /(password|passwd|secret|token|api[_-]?key|private[_-]?key)[ \t]*[=:][ \t]*[^ \t]/) || \
              (content ~ /BEGIN (RSA|OPENSSH|EC|PGP) PRIVATE KEY/)
    tokenshape = (content ~ /AKIA[0-9A-Z]{16}/) || (content ~ /ghp_[A-Za-z0-9]{20,}/) || \
                 (content ~ /xox[bap]-/) || (content ~ /sk-[A-Za-z0-9]{20,}/) || \
                 (content ~ /tskey-[a-z]+-/)
    if (generic || tokenshape) {
      if (lc !~ /redacted|change_me|_here|<[a-z_ ]+>|\$\{|xxxx|example|sample|dummy|placeholder|todo/) {
        print "  " file ": " content
        found = 1
      }
    }
  }
  END { exit (found ? 1 : 0) }
'
