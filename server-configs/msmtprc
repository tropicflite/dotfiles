# Install: sudo cp ~/dotfiles/server-configs/msmtprc /etc/msmtprc
# Note: replace MIGADU_PASSWORD_HERE with the current Migadu SMTP password
# (retrieve from: Migadu dashboard -> Email -> matt@wayoffcourse.ca -> Password)
# System-wide msmtp configuration (used by scripts that run as root/nut)
defaults
auth           on
tls            on
tls_starttls   on
logfile        /var/log/msmtp.log

account        migadu
host           smtp.migadu.com
port           587
from           matt@wayoffcourse.ca
user           matt@wayoffcourse.ca
password       MIGADU_PASSWORD_HERE

account default : migadu
