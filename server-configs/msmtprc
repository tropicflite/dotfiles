# Install: sudo cp ~/dotfiles/server-configs/msmtprc /etc/msmtprc && sudo chown root:nut /etc/msmtprc && sudo chmod 640 /etc/msmtprc
# ~/.msmtprc is the same content (matt:matt 600).
# Replace PROTON_SMTP_TOKEN_HERE with the Proton SMTP token "server-msmtp"
# (Proton Pass; or generate a new one: Proton -> Settings -> IMAP/SMTP -> SMTP tokens,
# address matt@wayoffcourse.ca). Proton login passwords do NOT work here.
# Migadu account kept as rollback until it lapses 2027-06-14 (MIGADU_PASSWORD_HERE
# from Migadu dashboard -> Email -> matt@wayoffcourse.ca -> Password).
# System-wide msmtp configuration (used by scripts that run as root/nut)
defaults
auth           on
tls            on
tls_starttls   on
logfile        /var/log/msmtp.log

account        proton
host           smtp.protonmail.ch
port           587
from           matt@wayoffcourse.ca
user           matt@wayoffcourse.ca
password       PROTON_SMTP_TOKEN_HERE

account        migadu
host           smtp.migadu.com
port           587
from           matt@wayoffcourse.ca
user           matt@wayoffcourse.ca
password       MIGADU_PASSWORD_HERE

account default : proton
