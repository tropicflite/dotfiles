# Install: sudo cp ~/dotfiles/server-configs/msmtprc /etc/msmtprc
# Note: replace BRIDGE_PASSWORD_HERE with the current Proton Bridge SMTP password
# (retrieve from: protonmail-bridge --cli → info)
# System-wide msmtp configuration
defaults
auth           on
tls            on
tls_starttls   on
tls_certcheck  off
logfile        /var/log/msmtp.log

account        proton
host           127.0.0.1
port           1025
from           nichols_matt@pm.me
user           nichols_matt@pm.me
password       BRIDGE_PASSWORD_HERE

account default : proton
