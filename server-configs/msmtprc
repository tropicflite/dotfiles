# Install: sudo cp ~/dotfiles/server-configs/msmtprc /etc/msmtprc && sudo chown root:nut /etc/msmtprc && sudo chmod 640 /etc/msmtprc
# ~/.msmtprc is the same content (matt:matt 600).
# Default account: migadu. Replace
# MIGADU_PASSWORD_HERE with the matt@wayoffcourse.ca mailbox password (Bitwarden
# "webmail.migadu.com"; reset via Migadu admin -> Mailboxes -> matt -> Password).
# System-wide msmtp configuration (used by scripts that run as root/nut)
defaults
auth           on
tls            on
tls_starttls   on
logfile        /var/log/msmtp.log

account        migadu
host           smtp.migadu.com
port           587
from           matt@wayoffcourse.ca
user           matt@wayoffcourse.ca
password       MIGADU_PASSWORD_HERE

account default : migadu
