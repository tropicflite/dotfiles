# Server-specific config
alias clip='tee /dev/tty | osc52-copy'
alias ruk='~/scripts/reset-uptime-kuma.sh'
alias cl='claude'
alias cld='claude --dangerously-skip-permissions'
alias cdk='cd ~/docker'
clipf() { cat "${1:--}" > /tmp/clip.txt && ssh -T phone "rm -f ~/storage/downloads/clip.txt && cat > ~/storage/downloads/clip.txt" < /tmp/clip.txt; rm -f /tmp/clip.txt; }
# Tailscale (server-specific with hostname flag)
alias rt='remind ~/.reminders'        # today
alias rw='remind ~/.reminders "*7"'
alias tson='sudo tailscale up --accept-dns=false --operator=matt --advertise-routes=10.0.0.0/24,192.168.50.0/24 --hostname=server'
alias tsoff='sudo tailscale down'
# Network
alias netstatus="tsstatus; vpnstatus"
alias vr='nvim ~/.reminders'
vpnstatus() {
  local wg_out
  wg_out=$(sudo wg show wg0 2>/dev/null)
  if [[ -z "$wg_out" ]]; then
    echo "WireGuard: DOWN (interface missing)"
    return
  fi
  local handshake
  handshake=$(echo "$wg_out" | grep "latest handshake" | awk '{print $3, $4, $5, $6}')
  local transfer
  transfer=$(echo "$wg_out" | grep "transfer" | awk '{print $2, $3, $4, $5, $6, $7}')
  echo "WireGuard: UP"
  [[ -n "$handshake" ]] && echo "  Last handshake: $handshake"
  [[ -n "$transfer" ]] && echo "  Transfer: $transfer"
}
export OLLAMA_HOST=http://100.78.51.10:11434
# Tailscale Funnel / FileBrowser toggle
fbon() {
  tailscale funnel reset
  tailscale serve reset
  tailscale serve --bg --https=8081 http://localhost:8081
  tailscale serve --bg --https=8082 http://localhost:8080
  tailscale serve --bg --https=8085 http://localhost:8084
  tailscale serve --bg --https=8090 http://localhost:8091
  tailscale serve --bg --https=8097 http://localhost:8096
  tailscale serve --bg --https=2283 http://localhost:2283
  tailscale serve --bg --https=3000 http://localhost:3001
  tailscale serve --bg --https=7777 http://localhost:7778
  tailscale serve --bg --https=8083 http://localhost:8083
  tailscale serve --bg --https=3003 http://localhost:3003
  tailscale serve --bg --https=2587 http://localhost:2587
  tailscale funnel --bg --https=443 http://127.0.0.1:8081
  echo "Funnel ON — FileBrowser public on 443"
}
fboff() {
  tailscale funnel reset
  tailscale serve reset
  tailscale serve --bg --https=443 http://localhost:3001
  tailscale serve --bg --https=8081 http://localhost:8081
  tailscale serve --bg --https=8082 http://localhost:8080
  tailscale serve --bg --https=8085 http://localhost:8084
  tailscale serve --bg --https=8090 http://localhost:8091
  tailscale serve --bg --https=8097 http://localhost:8096
  tailscale serve --bg --https=2283 http://localhost:2283
  tailscale serve --bg --https=3000 http://localhost:3001
  tailscale serve --bg --https=7777 http://localhost:7778
  tailscale serve --bg --https=8083 http://localhost:8083
  tailscale serve --bg --https=3003 http://localhost:3003
  tailscale serve --bg --https=2587 http://localhost:2587
  echo "Funnel OFF — Homepage on 443"
}
fbstatus() {
  tailscale serve status | grep -E "Funnel|ts.net \("
}
function docp {
  cd ~/docker && git add -A && git commit -m "${1:-update docker}" && git push
  # Note: git push is intentionally outside the && chain.
  # A silent push failure after a failed commit is worse than a redundant push.
  cd ~/
}
export GPG_TTY=$(tty)
