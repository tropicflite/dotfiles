# Quest-specific config
# Termux reports u0_a243@localhost — override agnoster's context segment
prompt_context() { prompt_segment black default "matt@quest"; }
echo quest > $PREFIX/etc/machine-name

# Package management (Termux)
alias pks="pkg search"
alias pki="pkg install"
alias pku="pkg upgrade"
# Tailscale (Termux — no tailscale command in PATH)
alias tsstatus='echo "Tailscale: check Android app (Settings → Tailscale)"'
alias netstatus='tsstatus && echo "ProtonVPN: check Android app"'
# Wake lock — tw surfaces the Termux notification; toggle acquire/release from its buttons
# (CLI release via termux-wake-unlock is unreliable on Quest's Android 12L base)
alias tw="quest-wake"
# Git SSH key
export GIT_SSH_COMMAND='ssh -i ~/.ssh/id_ed25519'
paste-from-clipboard() {
  LBUFFER+="$(termux-clipboard-get)"
}
zle -N paste-from-clipboard
bindkey '^v' paste-from-clipboard
# Auto-start sshd
sshd 2>/dev/null
